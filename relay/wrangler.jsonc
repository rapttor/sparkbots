{
  "name": "sparkbots-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // Free plan requires SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Extra browser Origins (exact match) besides any http://127.0.0.1|localhost:<port>. Non-browser clients send no Origin.
    "ALLOWED_ORIGINS": ""
  }
}
